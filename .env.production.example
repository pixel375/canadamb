APP_NAME=CanadaMB
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://canadamb.ca
APP_TIMEZONE=America/Winnipeg
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info

DB_CONNECTION=mariadb
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=replace_database_name
DB_USERNAME=replace_database_user
DB_PASSWORD=replace_database_password

SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Leave SESSION_DOMAIN unset for host-only cookies.

CACHE_STORE=database
QUEUE_CONNECTION=database
CANADAMB_CRON_QUEUE_DRAIN=true

# Exact hostnames come from the domains table. Forwarded host is ignored.
CANADAMB_TRUSTED_PROXIES=
# Passport keys live in shared private storage.
CANADAMB_SSO_ENABLED=true
# Generate a unique random value of at least 32 characters to enable news ingestion.
CANADAMB_NEWS_INGEST_TOKEN=

MAIL_MAILER=smtp
MAIL_HOST=replace_smtp_hostname
MAIL_PORT=587
MAIL_USERNAME=replace_smtp_username
MAIL_PASSWORD=replace_smtp_password
MAIL_FROM_ADDRESS=replace_with_verified_sender
MAIL_FROM_NAME=CanadaMB

FILESYSTEM_DISK=local
