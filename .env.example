APP_NAME=CanadaMB
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://canadamb.localhost:8000
APP_TIMEZONE=America/Winnipeg
CANADAMB_DEVELOPMENT_HOSTS=true

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=false
SESSION_ENCRYPT=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database

CANADAMB_SSO_ENABLED=true
CANADAMB_CRON_QUEUE_DRAIN=false
CANADAMB_MEDIA_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.test
MAIL_FROM_NAME=CanadaMB
